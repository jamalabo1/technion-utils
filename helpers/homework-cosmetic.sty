% Cosmetic/layout helpers for homework documents.
\ProvidesPackage{helpers/homework-cosmetic}[Homework layout helpers]

\RequirePackage{helpers/core}
\RequirePackage{framed}
\RequirePackage{tocloft}
\RequirePackage{keyval}

% ----CONTENTS PAGE----
\newif\ifshowcontents
\showcontentstrue % defaults to true
\DeclareOption{nocontents}{\showcontentsfalse}
\newif\ifshowsubquestiontitles
\showsubquestiontitlestrue % defaults to true
\DeclareOption{nosubquestiontitles}{\showsubquestiontitlesfalse}
\newcommand{\disablesubquestiontitles}{\showsubquestiontitlesfalse}
\newcommand{\enablesubquestiontitles}{\showsubquestiontitlestrue}
\newif\ifnumericsubquestions
\numericsubquestionsfalse % defaults to alphabetic subquestions
\DeclareOption{numericsubquestions}{\numericsubquestionstrue}
\DeclareOption{numericalsubquestions}{\numericsubquestionstrue}
\newcommand{\enablenumericsubquestions}{\numericsubquestionstrue}
\newcommand{\disablenumericsubquestions}{\numericsubquestionsfalse}
\newif\ifsubquestionpages
\subquestionpagesfalse % defaults to inline sub-subquestions
\DeclareOption{subquestionpages}{\subquestionpagestrue}
\DeclareOption{separatesubquestions}{\subquestionpagestrue}
\DeclareOption{seperatesubquestions}{\subquestionpagestrue}
\newcommand{\enablesubquestionpages}{\subquestionpagestrue}
\newcommand{\disablesubquestionpages}{\subquestionpagesfalse}
\newif\ifshowpartheadings
\showpartheadingsfalse % defaults to hiding part headings in the document body
\DeclareOption{showpartheadings}{\showpartheadingstrue}
\DeclareOption{partheadings}{\showpartheadingstrue}
\DeclareOption{hidepartheadings}{\showpartheadingsfalse}
\DeclareOption{nopartheadings}{\showpartheadingsfalse}
\newcommand{\enablepartheadings}{\showpartheadingstrue}
\newcommand{\disablepartheadings}{\showpartheadingsfalse}
\newif\ifcontextquestionnumbers
\contextquestionnumberstrue % defaults to part.question inside parts
\DeclareOption{contextquestionnumbers}{\contextquestionnumberstrue}
\DeclareOption{contextualquestionnumbers}{\contextquestionnumberstrue}
\DeclareOption{localquestionnumbers}{\contextquestionnumbersfalse}
\newcommand{\enablecontextquestionnumbers}{\contextquestionnumberstrue}
\newcommand{\disablecontextquestionnumbers}{\contextquestionnumbersfalse}

% Process selected options
\ProcessOptions\relax

