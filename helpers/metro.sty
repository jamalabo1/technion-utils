\ProvidesPackage{helpers/metro}[Custom Toloplogical and Metric spaces concepts]



% basics
\newcommand{\metric}[1]{\fn[d]{#1}{\R}}

% sets 
\newcommand{\closure}[1]{\mkern 1.5mu\overline{\mkern-1.5mu#1\mkern-1.5mu}\mkern 1.5mu}
\newcommand{\inter}[1]{(#1)^{\circ}}
\newcommand{\cl}{\closure}

% basis 
\newcommand{\basis}[1][B]{\mathcal{#1}}

% indexed family
\newcommand{\ifamily}[1][U]{\set{#1_i}_{i \in I}}